  "info": {
    "_postman_id": "b48628af-2447-4487-abc1-2663dbf7bd9e",
    "name": "Unisys Stealth Eco Combined Isolation Endpoint Isolation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Unisys Stealth EcoAPI provides programmatic access to the Unisys Stealth zero trust network segmentation platform. Security teams and automation platforms can use the EcoAPI to dynamically isolate and un-isolate endpoints and users from the Stealth network in response to security events or policy enforcement actions. The API also provides access to Stealth role configurations. Authentication uses HTTP Basic credentials (username and password) against the Stealth server endpoint.\n\nContact Support:\n Name: Unisys Stealth Support",
      "type": "text/plain"
    }
  }
