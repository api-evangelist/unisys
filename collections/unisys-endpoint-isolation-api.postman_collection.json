      "name": "Endpoint Isolation",
      "description": {
        "content": "Isolate and un-isolate endpoints from the Stealth network",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "5fa6ba7f-3d15-4ae4-a284-95dcfeaaa66d",
          "name": "Isolate Endpoint",
          "request": {
            "name": "Isolate Endpoint",
            "description": {
              "content": "Isolate a specific endpoint (identified by FQDN) from the Stealth zero trust network. The endpoint will be removed from its current Stealth communities and placed under the specified isolation role policy, preventing lateral movement and restricting network access until un-isolated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "endpoint",
                "isolate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the Stealth EcoAPI server",
                  "type": "any",
                  "value": "{{stealthHost}}",
                  "key": "stealthHost"
                },
                {
                  "description": "Port number of the Stealth EcoAPI server",
                  "type": "any",
                  "value": "{{stealthPort}}",
                  "key": "stealthPort"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"<string>\",\n  \"roleId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
