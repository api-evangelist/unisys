          "name": "Isolate Machine and User",
          "request": {
            "name": "Isolate Machine and User",
            "description": {
              "content": "Simultaneously isolate both an endpoint and a user from the Stealth zero trust network in a single API call. This is useful when responding to a security incident that requires immediate isolation of both the compromised machine and the associated user account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "isolate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the Stealth EcoAPI server",
                  "type": "any",
                  "value": "{{stealthHost}}",
                  "key": "stealthHost"
                },
                {
                  "description": "Port number of the Stealth EcoAPI server",
                  "type": "any",
                  "value": "{{stealthPort}}",
                  "key": "stealthPort"
                }
              ]
