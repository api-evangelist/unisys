          "id": "8d9fe54a-d594-4e84-aa23-79540306d343",
          "name": "Isolate User",
          "request": {
            "name": "Isolate User",
            "description": {
              "content": "Isolate a specific user from the Stealth zero trust network. All sessions and endpoints associated with the user will be placed under the isolation role policy, preventing the user from accessing network resources until un-isolated.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "user",
                "isolate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Hostname or IP address of the Stealth EcoAPI server",
                  "type": "any",
                  "value": "{{stealthHost}}",
                  "key": "stealthHost"
                },
                {
                  "description": "Port number of the Stealth EcoAPI server",
                  "type": "any",
                  "value": "{{stealthPort}}",
                  "key": "stealthPort"
                }
              ]
            },
